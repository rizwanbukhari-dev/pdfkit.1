# PDFKit Environment Configuration Template
# Copy this file to .env.local for local development.
# In Vercel, configure this variable in Project Settings > Environment Variables.

# Web3Forms Access Key
# 1. Visit https://web3forms.com
# 2. Enter your email to receive your free Access Key.
# 3. Paste the key below (never commit your actual key to git).
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
